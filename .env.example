# Local development: leave empty to use the Vite /api proxy.
# Deployment: set the backend origin here, or configure a same-origin reverse proxy.
VITE_API_BASE_URL=
# Server-side Vite setting; never contains credentials.
API_PROXY_TARGET=http://localhost:5299

# Enable only after the realtime outbox migration is deployed and Realtime:Enabled=true.
VITE_REALTIME_ENABLED=false
